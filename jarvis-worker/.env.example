# Liljeblads / Supabase (LangGraph worker → Jarvis webhook)
# Prefer jarvis-webhook; crewai-webhook is a legacy URL alias with the same code.
LILJEBLADS_WEBHOOK_URL=https://ojiswgqntenvbwtopxbu.supabase.co/functions/v1/jarvis-webhook
LILJEBLADS_API_KEY=lbl_your_api_key_here

# Google Gemini (chat + extract)
GOOGLE_API_KEY=AIza...
GEMINI_MODEL=gemini-flash-latest

# Local inbox
INBOX_DIR=./inbox
ARCHIVE_DIR=./inbox/processed
FAILED_DIR=./inbox/failed

# MODE:
#   live     = skapa arbetsordrar + service (full automation)
#   hitl     = service ok; WO → pending AI-förslag (rekommenderat i vardagen)
#   suggest  = legacy alias för hitl
#   dry_run  = bara extrahera, inga skrivningar
MODE=hitl
AUTO_LOG_SERVICE=true
AUTO_CREATE_WORK_ORDERS=true
SOURCE_LABEL=jarvis_inbox

# Optional: email summary after each ingest (same Resend key as Supabase)
RESEND_API_KEY=re_...
RESEND_FROM=Liljeblads <onboarding@resend.dev>
# auto = e-post till användaren som skapade API-nyckeln (inloggad user)
NOTIFY_EMAIL=auto

# Google Drive inbox (schema 08/15 kör --sync-drive)
DRIVE_SYNC_ENABLED=true
GOOGLE_DRIVE_FOLDER_ID=
# Path to service account JSON with Drive read access to the folder
GOOGLE_APPLICATION_CREDENTIALS=./credentials/google-service-account.json
# Or short-lived token instead of service account:
# GOOGLE_DRIVE_ACCESS_TOKEN=
