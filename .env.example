# Copy to .env and fill in values from your Supabase project:
# Dashboard → Project Settings → API
#
# Current project (Liljeblads2.0): ojiswgqntenvbwtopxbu

VITE_SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=your-anon-or-publishable-key
VITE_SUPABASE_PROJECT_ID=YOUR_PROJECT_REF

# Optional: local Jarvis worker (also in jarvis-worker/.env)
# LILJEBLADS_API_KEY=lbl_...

# Optional aliases for tooling
SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
SUPABASE_PUBLISHABLE_KEY=your-anon-or-publishable-key

# Edge secrets (set in Supabase Dashboard or CLI — not committed here):
#
# Recommended: Grok (xAI) — capable + cost-efficient for Jarvis
#   npx supabase secrets set XAI_API_KEY=xai-...
#   npx supabase secrets set LLM_PROVIDER=xai
#   npx supabase secrets set XAI_MODEL=grok-4.3
#   # optional cost caps: LLM_MAX_TOKENS=2048  LLM_MAX_HISTORY_MESSAGES=24
#   # Jarvis voice (edge jarvis-tts): XAI_TTS_VOICE=ara  (warm; also eve/rex/luna)
#
# Fallback / embeddings: Gemini still useful for embeddings if used
#   npx supabase secrets set GOOGLE_AI_API_KEY=...
#   npx supabase secrets set GEMINI_MODEL=gemini-flash-latest
#
#   npx supabase secrets set RESEND_API_KEY=...
#   npx supabase secrets set CRON_SECRET=...
# See docs/DU_GOR_DETTA.md
